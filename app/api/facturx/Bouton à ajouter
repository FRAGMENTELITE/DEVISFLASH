<button onClick={async () => {
  const res = await fetch('/api/facturx', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ client: 'Dupont', numero: 'F2026-001', totalHT: 1000 })
  });
  const blob = await res.blob();
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'Facture-Factur-X.pdf';
  a.click();
}} className="bg-green-600 text-white px-6 py-3 rounded-lg font-bold">
  ✅ Facture Électronique 2026
</button>
